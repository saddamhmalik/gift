# Copy to .env and fill values. Used by docker-compose.
# Server IP (current): 13.202.3.204
# Later: set APP_URL / FRONTEND_URL to your domain and subdomain.

APP_NAME=PayFlex
APP_ENV=production
APP_KEY=base64:YOUR_KEY_HERE
APP_DEBUG=false
APP_URL=http://13.202.3.204:8000
FRONTEND_URL=http://13.202.3.204

# Ports on host (optional)
BACKEND_PORT=8000
FRONTEND_PORT=80

# Database (MySQL — service name in docker-compose is "mysql")
# DB_USERNAME must be "laravel" (MySQL image does not allow MYSQL_USER=root)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
# Host port for MySQL (optional, e.g. for external tools): 3306
# DB_PORT_EXTERNAL=3306

# Queue (redis = Horizon/queue; sync = inline, no Redis)
QUEUE_CONNECTION=redis
# Redis: use redis (Docker) or 127.0.0.1 when running artisan on host (Redis port 6379 is exposed)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PORT_EXTERNAL=6379  # leave unset to expose 6379; set empty to not expose

# Session & cache
CACHE_STORE=file
SESSION_DRIVER=file

# Mail (configure for production)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional: Woohoo, Google OAuth, etc. (copy from .env.example)
