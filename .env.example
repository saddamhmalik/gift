APP_NAME="Gift Box"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use redis for queues (required for Horizon). Run: php artisan horizon
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis (required for Horizon / queue)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin panel
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Woohoo (QwikGift) OAuth2
WOOHOO_BASE_URL=https://sandbox.woohoo.in
WOOHOO_CLIENT_ID=
WOOHOO_CLIENT_SECRET=
WOOHOO_USERNAME=
WOOHOO_PASSWORD=
# Optional: WOOHOO_TOKEN_CACHE_TTL=604800 (7 days)
# Optional: WOOHOO_USER_AGENT (if CloudFront 403, try browser UA)

# Google OAuth (for /api/v1/auth/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Catalog (optional)
# TRENDING_TOP_COUNT=50

# Order flow test script (scripts/test-order-flow.sh)
# TEST_EMAIL=test@example.com
# TEST_PASSWORD=password
