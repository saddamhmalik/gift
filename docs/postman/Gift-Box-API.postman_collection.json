{
  "info": {
    "name": "Gift Box API",
    "description": "Laravel REST API - Public, Auth, and Protected endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "order_token", "value": "" }
  ],
  "item": [
    {
      "name": "Public APIs",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/health"
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/categories"
          }
        },
        {
          "name": "Hot Deals",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/products/hot-deals?limit=20"
          }
        },
        {
          "name": "Trending",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/products/trending?limit=20"
          }
        },
        {
          "name": "Best Sellers",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/products/best-sellers?limit=20"
          }
        },
        {
          "name": "Featured",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/products/featured?limit=20"
          }
        },
        {
          "name": "New Arrivals",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/products/new-arrivals?limit=20"
          }
        },
        {
          "name": "Product Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/products/1"
          }
        }
      ]
    },
    {
      "name": "Order APIs (Protected – requires login)",
      "item": [
        {
          "name": "Create/Get Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/api/v1/order"
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/order"
          }
        },
        {
          "name": "Set Order Item (unit_price)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"product_id\":1,\"quantity\":2,\"unit_price\":500}" },
            "url": "{{base_url}}/api/v1/order/item"
          }
        },
        {
          "name": "Set Order Item (selected_denomination)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"product_id\":1,\"quantity\":1,\"selected_denomination\":\"1000\"}" },
            "url": "{{base_url}}/api/v1/order/item"
          }
        },
        {
          "name": "Update Order Item",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"quantity\":3}" },
            "url": "{{base_url}}/api/v1/order/item"
          }
        },
        {
          "name": "Clear Order Item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/order/item"
          }
        }
      ]
    },
    {
      "name": "Auth APIs",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"John Doe\",\"email\":\"john@example.com\",\"password\":\"password123\",\"password_confirmation\":\"password123\"}"
            },
            "url": "{{base_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"john@example.com\",\"password\":\"password123\"}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\":\"+919876543210\"}"
            },
            "url": "{{base_url}}/api/v1/auth/otp/send"
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\":\"+919876543210\",\"otp\":\"123456\"}"
            },
            "url": "{{base_url}}/api/v1/auth/otp/verify"
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"access_token\":\"YOUR_GOOGLE_ACCESS_TOKEN\"}"
            },
            "url": "{{base_url}}/api/v1/auth/google"
          }
        }
      ]
    },
    {
      "name": "Protected APIs (auth required)",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        }
      ]
    }
  ]
}
