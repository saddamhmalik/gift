{
  "info": {
    "name": "QwikGift - Get Categories",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. OAuth - Get Authorization Code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{client_id}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "https://sandbox.woohoo.in/oauth2/verify",
        "description": "Step 1: Get authorizationCode. Copy it from response for Step 2.",
        "event": [
          {
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "const code = json.authorizationCode || json.authorization_code;",
                "if (code) {",
                "    pm.collectionVariables.set('authorization_code', code);",
                "    console.log('authorization_code saved');",
                "}"
              ],
              "type": "text/javascript"
            }
          }
        ]
      }
    },
    {
      "name": "2. OAuth - Get Bearer Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{client_id}}\",\n  \"clientSecret\": \"{{client_secret}}\",\n  \"authorizationCode\": \"{{authorization_code}}\"\n}"
        },
        "url": "https://sandbox.woohoo.in/oauth2/token",
        "description": "Step 2: Get Bearer token. Copy 'token' from response for Categories request.",
        "event": [
          {
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "const token = json.token || json.access_token;",
                "if (token) {",
                "    pm.collectionVariables.set('bearer_token', token);",
                "    console.log('bearer_token saved');",
                "}"
              ],
              "type": "text/javascript"
            }
          }
        ]
      }
    },
    {
      "name": "3. Get Categories (full list)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const baseUrl = pm.collectionVariables.get('base_url') || pm.environment.get('base_url') || 'https://sandbox.woohoo.in';",
              "const method = pm.request.method;",
              "let url = pm.request.url.toString();",
              "url = url.replace(/\\{\\{base_url\\}\\}/g, baseUrl).replace(/\\{\\{category_id\\}\\}/g, pm.collectionVariables.get('category_id') || '7');",
              "",
              "const urlObj = new URL(url);",
              "let pathWithQuery = urlObj.pathname;",
              "if (urlObj.searchParams.toString()) {",
              "    const params = Array.from(urlObj.searchParams.entries()).sort((a, b) => a[0].localeCompare(b[0]));",
              "    const sortedQuery = new URLSearchParams(params).toString();",
              "    pathWithQuery = pathWithQuery + '?' + sortedQuery;",
              "}",
              "",
              "const fullUrl = urlObj.origin + pathWithQuery;",
              "const encodedUrl = encodeURIComponent(fullUrl);",
              "",
              "let baseString = method + '&' + encodedUrl;",
              "",
              "if (method === 'POST' && pm.request.body && pm.request.body.raw) {",
              "    try {",
              "        const body = JSON.parse(pm.request.body.raw);",
              "        const sortedBody = JSON.stringify(sortKeys(body));",
              "        const encodedBody = encodeURIComponent(sortedBody);",
              "        baseString = baseString + '&' + encodedBody;",
              "    } catch (e) {}",
              "}",
              "",
              "function sortKeys(obj) {",
              "    if (Array.isArray(obj)) return obj.map(sortKeys);",
              "    if (obj !== null && typeof obj === 'object') {",
              "        return Object.keys(obj).sort().reduce((acc, k) => { acc[k] = sortKeys(obj[k]); return acc; }, {});",
              "    }",
              "    return obj;",
              "}",
              "",
              "const clientSecret = pm.environment.get('client_secret') || pm.collectionVariables.get('client_secret');",
              "const signature = CryptoJS.HmacSHA512(baseString, clientSecret).toString(CryptoJS.enc.Hex);",
              "",
              "const dateAtClient = new Date().toISOString();",
              "",
              "pm.request.headers.upsert({ key: 'dateAtClient', value: dateAtClient });",
              "pm.request.headers.upsert({ key: 'signature', value: signature });",
              "pm.request.headers.upsert({ key: 'Accept', value: '*/*' });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/rest/v3/catalog/categories",
          "host": ["{{base_url}}"],
          "path": ["rest", "v3", "catalog", "categories"]
        },
        "description": "GET categories (full list). Requires dateAtClient and signature headers (set by pre-request script)."
      }
    },
    {
      "name": "4. Get Categories by ID",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const baseUrl = pm.collectionVariables.get('base_url') || pm.environment.get('base_url') || 'https://sandbox.woohoo.in';",
              "const method = pm.request.method;",
              "let url = pm.request.url.toString();",
              "url = url.replace(/\\{\\{base_url\\}\\}/g, baseUrl).replace(/\\{\\{category_id\\}\\}/g, pm.collectionVariables.get('category_id') || '7');",
              "",
              "const urlObj = new URL(url);",
              "let pathWithQuery = urlObj.pathname;",
              "if (urlObj.searchParams.toString()) {",
              "    const params = Array.from(urlObj.searchParams.entries()).sort((a, b) => a[0].localeCompare(b[0]));",
              "    const sortedQuery = new URLSearchParams(params).toString();",
              "    pathWithQuery = pathWithQuery + '?' + sortedQuery;",
              "}",
              "",
              "const fullUrl = urlObj.origin + pathWithQuery;",
              "const encodedUrl = encodeURIComponent(fullUrl);",
              "",
              "let baseString = method + '&' + encodedUrl;",
              "",
              "const clientSecret = pm.environment.get('client_secret') || pm.collectionVariables.get('client_secret');",
              "const signature = CryptoJS.HmacSHA512(baseString, clientSecret).toString(CryptoJS.enc.Hex);",
              "",
              "const dateAtClient = new Date().toISOString();",
              "",
              "pm.request.headers.upsert({ key: 'dateAtClient', value: dateAtClient });",
              "pm.request.headers.upsert({ key: 'signature', value: signature });",
              "pm.request.headers.upsert({ key: 'Accept', value: '*/*' });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/rest/v3/catalog/categories/{{category_id}}",
          "host": ["{{base_url}}"],
          "path": ["rest", "v3", "catalog", "categories", "{{category_id}}"]
        },
        "description": "GET single category by ID."
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://sandbox.woohoo.in"
    },
    {
      "key": "client_id",
      "value": ""
    },
    {
      "key": "client_secret",
      "value": ""
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "authorization_code",
      "value": ""
    },
    {
      "key": "bearer_token",
      "value": ""
    },
    {
      "key": "category_id",
      "value": "7"
    }
  ]
}
